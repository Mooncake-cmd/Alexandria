# Guarda os valores atuais de LOCAL_* (expansão imediata) antes do próximo CLEAR_VARS.
ifneq ($(filter $(LOCAL_MODULE),$(MODULES)),$(LOCAL_MODULE))
MODULES += $(LOCAL_MODULE)
endif
MODULE_PATH.$(LOCAL_MODULE) := $(LOCAL_PATH)
MODULE_SRC.$(LOCAL_MODULE) := $(LOCAL_SRC_FILES)
MODULE_CFLAGS.$(LOCAL_MODULE) := $(LOCAL_CFLAGS)
MODULE_CPPFLAGS.$(LOCAL_MODULE) := $(LOCAL_CPPFLAGS)
MODULE_INC.$(LOCAL_MODULE) := $(LOCAL_C_INCLUDES) $(LOCAL_EXPORT_C_INCLUDES)
MODULE_EXPORT.$(LOCAL_MODULE) := $(LOCAL_EXPORT_C_INCLUDES)
MODULE_STATIC.$(LOCAL_MODULE) := $(LOCAL_WHOLE_STATIC_LIBRARIES) $(LOCAL_STATIC_LIBRARIES)
MODULE_LDLIBS.$(LOCAL_MODULE) := $(LOCAL_LDLIBS)
